@page "/leaderboards"

@using System.Collections.Concurrent
@using CodeGolf.Pages
@using CodeGolf.Services
@inject ProblemService ProblemService
@implements IDisposable


<PageTitle>Leaderboards</PageTitle>
<h1>Leaderboards</h1>
<div class="leaderboard-container">
    <h2>Total</h2>
    <LayoutView>
        <LayoutView>
            <h3>Leaderboard Fux</h3>
            <table>
                @foreach (var total in totalsFux)
                {
                    <tr>
                        <td>@total.Key</td>
                        <td>@total.Value</td>
                    </tr>
                }

            </table>
        </LayoutView>
        <LayoutView>
            <h3>Leaderboard Uncle</h3>
            <table>
                @foreach (var total in totalsFux)
                {
                    <tr>
                        <td>@total.Key</td>
                        <td>@total.Value</td>
                    </tr>
                }
            </table>
        </LayoutView>
    </LayoutView>
    
    
    <h2>Per problem</h2>
    @foreach (var problem in problems)
    {
        <h2>@problem.Key</h2>
        <LayoutView>
            <LayoutView>
                <h3>Leaderboard Fux</h3>
                <table>
                    @foreach (var answer in problem.Value.HighboardFux)
                    {
                        <tr>
                            <td>@answer.Item1</td>
                            <td>@answer.Item2</td>
                        </tr>
                    }
                </table>
            </LayoutView>
            <LayoutView>
                <h4>Leaderboard Uncle</h4>
                <table>
                    @foreach (var answer in problem.Value.Highboard)
                    {
                        <tr>
                            <td>@answer.Item1</td>
                            <td>@answer.Item2</td>
                        </tr>
                    }
                </table>
            </LayoutView>
        </LayoutView>
    }
</div>

@code{
    private readonly ConcurrentDictionary<String, int> totalsUncle = [];
    private readonly ConcurrentDictionary<String, int> totalsFux = [];
    private readonly ConcurrentDictionary<string, Tables> problems = [];
    private readonly System.Timers.Timer updateTimer = new(TimeSpan.FromMinutes(1));

    protected override void OnInitialized()
    {
        updateTimer.Elapsed += UpdateTick;
        updateTimer.Start();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if(!firstRender) return;

        var problemNames = ProblemService.GetAllProblems();
        foreach(var problemName in problemNames)
        {
            problems[problemName] = new Tables(problemName, ProblemService);
        }

        StateHasChanged();
        
    }

    public void Dispose()
    {
        updateTimer.Elapsed -= UpdateTick;
        updateTimer.Stop();
        updateTimer.Dispose();
    }

    private void UpdateTick(object? _sender, System.Timers.ElapsedEventArgs _args) => UpdateLeaderboards();

    private void UpdateLeaderboards()
    {
        foreach (var table in problems.Values)
        {
            table.UpdateLeaderboard();
            foreach (var row in table.HighboardFux)
            {
                var score = 100 - row.Item2;
                totalsFux.AddOrUpdate(
                    row.Item1,
                    static (key, newValue) => newValue,
                    static (key, previousValue, newValue) => previousValue + newValue,
                    score);
            }

            foreach (var row in table.Highboard)
            {
                var score = 100 - row.Item2;
                totalsUncle.AddOrUpdate(
                    row.Item1,
                    static (key, newValue) => newValue,
                    static (key, previousValue, newValue) => previousValue + newValue,
                    score);
            }
        }
        
        StateHasChanged();
    }

    private class Tables
    {
        public string ProblemName {get; init;}
        public ProblemService ProblemService {get; init;}
        public IReadOnlyCollection<(string, int)> HighboardFux {get; private set;}
        public IReadOnlyCollection<(string, int)> Highboard {get; private set;}

        public Tables(string problemName, ProblemService problemService){
            ProblemName = problemName;
            ProblemService = problemService;
            UpdateLeaderboard();
        }

        public void UpdateLeaderboard()
        {
            HighboardFux = ProblemService.GetHighScores(ProblemName, true);
            Highboard = ProblemService.GetHighScores(ProblemName, false);
        }
    }
}
