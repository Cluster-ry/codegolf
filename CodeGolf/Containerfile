FROM mcr.microsoft.com/dotnet/sdk:8.0 as build
WORKDIR /source

COPY *.csproj .
RUN dotnet restore "CodeGolf.csproj" --use-current-runtime

COPY . .
RUN dotnet publish "CodeGolf.csproj" -c Release -o /app --use-current-runtime --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0
WORKDIR /app
COPY --from=build /app .
ENTRYPOINT ["dotnet", "CodeGolf.dll"]