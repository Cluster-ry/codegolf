@page "/"

@using System.Text.Json
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using CodeGolf.Services;

@inject GroupHandler GroupHandler
@inject ILogger<Index> Logger
@inject ILogger<UserActivityLog> UserActivity
@inject GroupService GroupService

<PageTitle>Index</PageTitle>

<h1>Hello, world!</h1>
<p>Welcome to Cluster 202X Code-golf.</p>

<p>
    The aim of this is to finish the following coding tasks with the lowest amount of characters used, just like in real golf.
    You need to gather all your wits and group members and put your working heads together.
</p>
<div>
<EditForm Model="@Model" OnValidSubmit="@OnValidSubmit">
    <label>Who are you?</label>
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    <div>
        <label for="groupName">
            Group name:
            <InputText id="groupName" @bind-Value="Model!.Name"/>
        </label>
    </div>
    <div class="inline">
        <label for="isFux">Are you fux?</label>
        <InputCheckbox id="isFux" @bind-Value="Model!.IsFresher"></InputCheckbox>
    </div>
    <div>
        <label>
            Who is in your group?
            <InputText @bind-Value="Model!.GroupMember0"></InputText>
            <InputText @bind-Value="Model!.GroupMember1"></InputText>
            <InputText @bind-Value="Model!.GroupMember2"></InputText>
        </label>
    </div>
    @if (isSubmitting)
    {
        <p class="submission-status submitting" role="status" aria-live="polite">Registering your group…</p>
    }
    else if (hasRegistrationResult)
    {
        <div class="submission-status @(registrationSucceeded ? "success" : "failure")" role="status" aria-live="polite">
            @if (registrationSucceeded)
            {
                <strong>Registered!</strong>
            }
            else
            {
                <strong>Could not register.</strong>
            }
            <span>@registrationMessage</span>
        </div>
    }
    <div>
        <button type="submit" disabled="@isSubmitting">@(isSubmitting ? "Submitting…" : "Submit")</button>
    </div>
</EditForm>
</div>


@code{
    public GroupSubmission? Model { get; set; }
    public static String localStorageGroupKey = "GroupInformation";
    private bool isSubmitting;
    private bool hasRegistrationResult;
    private bool registrationSucceeded;
    private string registrationMessage = "";

    protected override void OnInitialized() => Model ??= new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var result = await GroupHandler.Load();
        
        if(result is null) return;

        UserActivity.UserSessionRestored(result.Name, result.IsFresher);
        Model = result;
        StateHasChanged();
    }
    
    private async Task OnValidSubmit()
    {
        if(Model is null)
        {
            Logger.LogInformation("Submitted null Model");
            return;
        }

        isSubmitting = true;
        hasRegistrationResult = false;

        try
        {
            var memberCount = new[] { Model.GroupMember0, Model.GroupMember1, Model.GroupMember2 }
                .Count(member => !string.IsNullOrWhiteSpace(member));
            UserActivity.UserRegisteringGroup(Model.Name.Trim(), Model.IsFresher, memberCount);
            var result = GroupService.RegisterGroup(Model);

            registrationSucceeded = result.Status == GroupRegistrationStatus.Success;
            registrationMessage = result.Message;
            hasRegistrationResult = true;

            if (registrationSucceeded)
            {
                await GroupHandler.Save(Model);
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }
}