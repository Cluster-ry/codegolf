@page "/Problems/Fizzbuzz"
@using System.ComponentModel.DataAnnotations;
@using CodeGolf.DataBase.Entities
@using CodeGolf.Services
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ProtectedLocalStorage LocalStorage
@inject ILogger<Problem> Logger
@inject ProblemService ProblemService



<PageTitle>@Problem?.Name</PageTitle>

<text>
    @Problem?.Explanation
</text>
<div>
    <EditForm Model="@Model" OnValidSubmit="@OnSubmit">
        <DataAnnotationsValidator/>
        <ValidationSummary/>
        <div>
            <label>
                Answer the problem:
                <InputText @bind-Value="Model.CurrentAnswer"/>
            </label>
        </div>
        <div>
            <button type="submit">Submit</button>
        </div>
    </EditForm>
</div>

@code{
    private static int _problemIndex = 0;
    public Problem? Problem => ProblemService.GetProblem(_problemIndex);
    
    public static String localStorageAnswerKey = "RecentProblemAnswer";
    public static String localStorageGroupKey = "GroupInformation";
    
    public Answer? Model { get; set; }
    
    protected override void OnInitialized() => Model ??= new();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var result = await LocalStorage.GetAsync<Answer>(localStorageAnswerKey);
        if (result.Success)
        {
            Model = result.Value;
            StateHasChanged();
        }
    }
    
    private async Task OnSubmit()
    {
        Logger.LogInformation($"Submitted code: {Model}");
        await LocalStorage.SetAsync(localStorageGroupKey, Model);
        //TODO get group save it and send answer for checking.
        //var group = LocalStorage.GetAsync<Index.GroupSubmission>(localStorageGroupKey);
        
        
    }

    public class Answer
    {
        public string CurrentAnswer { get; set; }
    }
}