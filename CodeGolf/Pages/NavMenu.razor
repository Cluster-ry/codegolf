@using CodeGolf.Services
@using System.Collections.ObjectModel
@inject ProblemService ProblemService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CodeGolf</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @foreach(var problemKey in Problems)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href=@($"Problems/{problemKey}")>
                    <span class="oi oi-plus" aria-hidden="true"></span> @problemKey
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href=@($"leaderboards/")>
                <span class="oi oi-list-rich" aria-hidden="true"></span> Leaderboards
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private Collection<string> Problems {get;} = new();

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender) return;
        foreach(var problemKey in ProblemService.GetAllProblems())
        {
            Problems.Add(problemKey);
        }
        StateHasChanged();
    }


    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }
}