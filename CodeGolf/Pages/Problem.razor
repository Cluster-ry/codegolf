@page "/problems/{ProblemName}"

@using CodeGolf.DataBase.Entities
@using CodeGolf.Services
@using CodeGolf.Pages

@using System.ComponentModel.DataAnnotations;
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ILogger<Problem> Logger
@inject GroupHandler GroupHandler
@inject ProblemHandler ProblemHandler

<PageTitle>@ProblemDefinition?.Title</PageTitle>
<h1>@ProblemDefinition?.Title</h1>

<p>@ProblemDefinition?.Explanation</p>

<EditForm Model="@ProblemSubmission" OnValidSubmit="@OnValidSubmit">
    <DataAnnotationsValidator/>
    <ValidationSummary/>
    <label>
        Answer to the problem:
        <InputTextArea @bind-Value="@ProblemSubmission.CurrentSolution" />
    </label>
    <p>Current submission length: @ProblemSubmission.SubmissionLength</p>
    <button type="submit">Submit</button>
</EditForm>

<div>
<h2>Outputs</h2>
<label>
    Example Output:
    <blockquote>
        <pre>
        <code>@ProblemDefinition?.ExampleOutput</code>
        </pre>
    </blockquote>
</label>


<label>
    Current Output:
    <blockquote>
        <pre>
        <code>@ProblemSubmission?.CurrentOutput</code>
        </pre>
    </blockquote>
</label>
</div>

@code {
    [Parameter]
    public string ProblemName {get; init;}
    private string previousProblemName;

    public ProblemDefinition? ProblemDefinition {get; private set;}
    public ProblemSubmission? ProblemSubmission {get; private set;}

    protected override void OnInitialized()
    {
        ProblemSubmission ??= new ProblemSubmission(){
            ProblemName = ProblemName,
        };
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(!firstRender && ProblemName == previousProblemName) return;
        previousProblemName = ProblemName;

        ProblemDefinition = LoadProblem();
        ProblemSubmission = await LoadPreviousSubmission();
        StateHasChanged();
    }

    private ProblemDefinition? LoadProblem()
    {
        return ProblemHandler.LoadDefinition(ProblemName);
    }

    private async Task<ProblemSubmission> LoadPreviousSubmission()
    {
        var submission = await ProblemHandler.LoadSubmission(ProblemName);
  
        return new ProblemSubmission{
            ProblemName = ProblemName,
            CurrentSolution = submission,
        };
    }

    private async Task OnValidSubmit()
    {
        Logger.LogInformation("Submitted code:\n{Submission}", ProblemSubmission.CurrentSolution);
        await ProblemHandler.SaveSubmission(ProblemName, ProblemSubmission.CurrentSolution);
        (bool success, string currentOutput) = await ProblemHandler.EvaluateSubmission(ProblemName, ProblemSubmission.CurrentSolution);

        ProblemSubmission.CurrentOutput = currentOutput;
        ProblemSubmission.Success = success;
        StateHasChanged();
    }
}
