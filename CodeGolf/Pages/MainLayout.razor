@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navigation
@inject ILogger<UserActivityLog> UserActivity

<PageTitle>CodeGolf</PageTitle>

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!--
        <div class="top-row px-4">
            <a href="https://github.com/orgs/Cluster-ry" target="_blank">About</a>
        </div>
        -->
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        LogPageView(Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
        => LogPageView(Navigation.ToBaseRelativePath(args.Location));

    private void LogPageView(string path)
    {
        if (string.IsNullOrEmpty(path))
        {
            path = "/";
        }

        UserActivity.UserPageView(path);
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
